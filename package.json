{
  "name": "test-automation-kit",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:fe": "playwright test tests/fe",
    "test:api": "playwright test tests/api",
    "test:mobile-web": "playwright test tests/mobile-web",
    "profile:create": "node scripts/utils/create_profile.js",
    "test:task": "node scripts/utils/run_playwright_task.js",
    "test:task:fe": "node scripts/utils/run_playwright_task.js --suite fe",
    "test:task:api": "node scripts/utils/run_playwright_task.js --suite api",
    "report": "node scripts/show_report.js",
    "user-guide:images": "node scripts/utils/generate_user_guide_images.mjs",
    "dashboard": "node scripts/qa/dashboard_generate.js",
    "accessibility": "node scripts/qa/accessibility_check.js",
    "perf": "node scripts/qa/perf_check.js",
    "security": "node scripts/qa/security_check.js",
    "load": "node scripts/qa/load_check.js",
    "risk": "node scripts/qa/risk_score.js",
    "risk:gate": "node scripts/qa/risk_gate.js",
    "risk:gate:enforce": "node scripts/qa/risk_gate.js --enforce",
    "seed:knowledge": "node scripts/qa/seed_knowledge_from_jira.js",
    "seed:knowledge:apply": "node scripts/qa/seed_knowledge_from_jira.js --apply",
    "gate:output": "node scripts/qa/output_gate.js --mode test-execution",
    "gate:output:fix": "node scripts/qa/output_gate.js --mode test-execution --fix",
    "gate:gen-testcase": "node scripts/qa/output_gate.js --mode gen-testcase",
    "integration:check": "node scripts/integrations/jira/check_connection.js",
    "integration:check:live": "node scripts/integrations/jira/check_connection.js --live",
    "jira:testcase-publish": "node scripts/integrations/jira/publish_testcases.js",
    "jira:testcase-publish:dry-run": "node scripts/integrations/jira/publish_testcases.js --dry-run",
    "jira:testcase-cleanup": "node scripts/integrations/jira/cleanup_xray_tests.js",
    "jira:testcase-cleanup:dry-run": "node scripts/integrations/jira/cleanup_xray_tests.js --dry-run",
    "jira:bug-report": "node scripts/integrations/jira/bug_reporter.js",
    "jira:bug-report:dry-run": "node scripts/integrations/jira/bug_reporter.js --dry-run"
  },
  "dependencies": {
    "axe-core": "^4.12.1",
    "axios": "1.17.0",
    "exceljs": "^3.4.0",
    "form-data": "^4.0.6",
    "googleapis": "^150.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/pg": "^8.20.0"
  }
}
