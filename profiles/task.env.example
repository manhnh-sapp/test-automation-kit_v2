# ============================================================
# TASK PROFILE TEMPLATE
# Copy file này sang  profiles/<TASK_KEY>/task.env  rồi điền giá trị thật.
#
# Chứa GIÁ TRỊ ĐỘNG theo từng task. Giá trị TĨNH dùng chung (base URL + API key:
# Figma / Confluence / Jira / Xray / HubSpot) để ở .env chung, KHÔNG lặp ở đây.
#
# ⚠️ File task.env THẬT không commit (đã gitignore: `profiles/**/task.env`) vì chứa
#    credential. Chỉ commit file .example này.
#
# Tạo nhanh (khỏi copy tay):
#   node scripts/utils/create_profile.js <TASK_KEY> [--project-output outputs/<YOUR_PROJECT>]
#   → sinh profiles/<TASK_KEY>/task.env từ template này, prefill TASK_KEY + JIRA_STORY_KEY;
#     QA chỉ điền credential + link. KHÔNG ghi đè nếu file đã tồn tại.
#
# Chạy:
#   PowerShell: $env:TASK_ENV='profiles/<TASK_KEY>/task.env'; npm run test:task -- --task <TASK_KEY> --project-output <PROJECT_OUTPUT_DIR>
#   Bash:       TASK_ENV=profiles/<TASK_KEY>/task.env npm run test:task -- --task <TASK_KEY> --project-output <PROJECT_OUTPUT_DIR>
# ============================================================

# --- Scope ---
PROJECT_OUTPUT_DIR=outputs/<YOUR_PROJECT>
TASK_KEY=<TASK_KEY>
TASK_NAME=<Tên module/feature của task>
RUN_ID=

# --- Link tài liệu task (URL đầy đủ; GOOGLE_* nhận URL hoặc ID; trống nếu không dùng) ---
JIRA_STORY_KEY=<TASK_KEY>
JIRA_STORY_URL=<URL Jira story/task>
JIRA_EPIC_URL=
CONFLUENCE_REQUIREMENT_URL=
CONFLUENCE_BRD_URL=
GOOGLE_DOCUMENT_ID=
GOOGLE_SHEET_URL=
FIGMA_FILE_URL=

# --- Jira/Xray assignee (accountId/email/tên hiển thị; trống = không gán) ---
JIRA_FE_ASSIGNEE=
JIRA_BE_ASSIGNEE=
JIRA_XRAY_ASSIGNEE=
XRAY_EXECUTION_DONE_STATUS=

# --- Tài khoản OPS/LMS theo task (điền giá trị thật; KHÔNG commit) ---
LMS_USERNAME=
LMS_PASSWORD=
OPS_USERNAME=
OPS_PASSWORD=
OPS_RESTRICTED_USER=
OPS_RESTRICTED_PASS=

# --- API token OPS/LMS theo task (mỗi task/tài khoản một token riêng) ---
OPS_API_TOKEN=
LMS_API_TOKEN=

# --- HubSpot (thường để ở .env chung; chỉ override per-task khi cần) ---
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
