# ============================================================
# GOOGLE DOCS INTEGRATION - Environment Variables
# ============================================================
# Copy file này thành .env và điền giá trị thực tế
#   cp .env.example .env
#
# QUAN TRỌNG: KHÔNG commit file .env hoặc service-account.json vào Git!
# ============================================================

# --- Xác thực (khuyến nghị: Service Account) ---
#
# Service Account (đọc được cả Doc riêng tư đã share cho service account)
# - Tải file credentials JSON từ Google Cloud Console
# - Đặt đường dẫn tương đối tới file (so với thư mục này)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# API Key (LƯU Ý: Docs API thường KHÔNG hỗ trợ API key cho documents.get,
# khác với Sheets. Ưu tiên dùng Service Account.)
# GOOGLE_API_KEY=your-google-api-key-here

# --- Google Docs Configuration ---

# Document ID mặc định — lấy từ URL của Google Doc:
# https://docs.google.com/document/d/<DOCUMENT_ID>/edit
# (Có thể bỏ trống và truyền --doc "<ID/URL>" khi chạy reader)
GOOGLE_DOCUMENT_ID=your-document-id-here

# --- Output Configuration ---

# Thư mục lưu file output mặc định (relative từ project root).
# Bỏ trống sẽ tự lưu vào <PROJECT_OUTPUT_DIR>/tasks/<TASK_KEY>/requirements/google_doc/
# OUTPUT_DIR=requirements/google_doc

# Timezone để format timestamp trong report (VD: Asia/Ho_Chi_Minh)
TIMEZONE=Asia/Ho_Chi_Minh
