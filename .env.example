# Copy file này thành .env.local hoặc .env rồi điền giá trị thật.
# Không commit file chứa secret thật.
#
# LƯU Ý (chạy song song nhiều task): file này chỉ nên giữ GIÁ TRỊ TĨNH dùng chung mọi task
# (Figma/Confluence/Jira/Xray/HubSpot API key + base URL). Giá trị ĐỘNG theo task
# (PROJECT_OUTPUT_DIR, TASK_KEY, link story/confluence/figma cụ thể, tài khoản OPS/LMS)
# đặt trong profiles/<TASK_KEY>/task.env và nạp qua TASK_ENV. Xem QUICKSTART.md (mục Parallel Story Safety).

# Project output
PROJECT_OUTPUT_DIR=outputs/<YOUR_PROJECT>
TASK_KEY=<TASK_KEY>
TASK_OUTPUT_DIR=
RUN_ID=

# App/site URLs
# LMS
LMS_BASE_URL=
LMS_LOGIN_URL=
LMS_USERNAME=
LMS_PASSWORD=
LMS_API_BASE_URL=
LMS_SWAGGER_URL=
# API token LMS — biến ĐỘNG theo task, ưu tiên đặt trong profiles/<TASK_KEY>/task.env; đây chỉ là default chung.
LMS_API_TOKEN=

# OPS
OPS_BASE_URL=
OPS_LOGIN_URL=
OPS_URL=
OPS_USERNAME=
OPS_PASSWORD=
OPS_API_BASE_URL=
OPS_SWAGGER_URL=
# API token OPS — biến ĐỘNG theo task, ưu tiên đặt trong profiles/<TASK_KEY>/task.env; đây chỉ là default chung.
OPS_API_TOKEN=

# URL feature/module tuỳ project
FEATURE_1_URL=
FEATURE_2_URL=
FEATURE_3_URL=

# Jira
JIRA_URL=
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PAT=
JIRA_PROJECT_KEY=
JIRA_EPIC_URL=
JIRA_STORY_URL=
JIRA_STORY_KEY=
JIRA_DEV_ASSIGNEE=
JIRA_FE_ASSIGNEE=
JIRA_BE_ASSIGNEE=
JIRA_BUG_ISSUE_TYPE=Sub-bug
JIRA_SPRINT_FIELD_ID=
TEST_MANAGEMENT_TOOL=xray
JIRA_TESTCASE_ISSUE_TYPE=Test
# Nguồn testcase cho Phase 2 execute/rerun: xray (MẶC ĐỊNH) hoặc excel.
# xray = execute từ testcase trên Xray: pull_testcases.js kéo về test-cases/from-xray/*.xlsx TRƯỚC khi chạy.
#   (Phase 1 VẪN gen Excel như cũ + phải publish testcase lên Xray; cần XRAY_CLIENT_ID/SECRET.)
# excel = chạy thuần từ test-cases/*.xlsx local (dùng khi chưa publish, hoặc muốn offline).
TESTCASE_SOURCE=xray
# Đẩy kết quả execute lên Xray dưới dạng Test Execution (push_test_execution.js).
#   confirm (MẶC ĐỊNH) = ở PHASE 2, khi cycle execute conclusive: chạy DRY-RUN trình preview cho QA;
#                        **chỉ tạo thật sau khi QA XÁC NHẬN** (--write). RE-RUN thì TỰ TẠO luôn (không
#                        cần xác nhận) vì là mốc verify rõ ràng.
#   auto  = tạo ngay không cần xác nhận ở mọi nơi (unattended/CI).
#   0     = không bao giờ đẩy (kể cả re-run).
#   Guard chung: bỏ qua mềm nếu thiếu Xray creds/status; KHÔNG tạo nếu run không conclusive
#   (0 PASSED/FAILED, toàn TO DO = debug/partial/setup-lỗi) trừ khi --force.
PUSH_XRAY_EXECUTION=confirm
# testcase-status.json NÊN dùng ĐÚNG tên trạng thái Xray: PASSED / FAILED / TO DO / EXECUTING.
# Bảng dưới map các alias kit cũ (PASS/FAIL/SKIP/BLOCKED) -> tên Xray; script validate qua getStatuses().
# Instance hiện chỉ có 4 status trên → SKIP và BLOCKED cùng về "TO DO" (phân biệt giữ ở comment).
XRAY_STATUS_PASS=PASSED
XRAY_STATUS_FAIL=FAILED
XRAY_STATUS_SKIP=TO DO
XRAY_STATUS_BLOCKED=TO DO
# Tùy chọn Test Execution:
# Tên Test Execution mặc định: "[<TASK_KEY>] Test Execution - <scope> - <version>".
#  - scope: XRAY_EXECUTION_SCOPE_LABEL (mặc định "Full testcases"; subset/re-run có thể đổi).
#  - version: tự lấy fixVersions của task; hoặc ép bằng RELEASE_VERSION. --summary override toàn bộ.
XRAY_EXECUTION_SCOPE_LABEL=Full testcases
RELEASE_VERSION=
XRAY_TEST_ENVIRONMENTS=
# Gắn mỗi Test Execution vào Test Plan CÓ SẴN (release/sprint) để roll-up trạng thái qua nhiều lần chạy.
# Test Plan do QA tạo/sở hữu trong Xray; kit chỉ link (info.testPlanKey), KHÔNG tự tạo. Bỏ trống = không gắn.
XRAY_TEST_PLAN_KEY=
XRAY_EXECUTION_WITH_EVIDENCE=0
# Step-level status trong Test Run: off = chỉ set status tổng của test (step giữ "TO DO");
#   pass (mặc định) = test PASSED thì set MỌI step = PASSED (step xanh khớp overall), test khác giữ TO DO;
#   mirror = mọi step = status tổng (kể cả FAILED → mọi step FAILED, thô). Cần Xray API key để đọc số step.
# Case FAILED: nếu testcase-status.json có steps[] hoặc failedStep + evidence, kit set đúng bước FAILED
# và gắn evidence vào bước đó (kể cả khi mode=pass) — không chỉ FAIL tổng.
XRAY_EXEC_STEP_STATUS=pass
# Sau khi push XONG (kết quả đã import; Phase 2 = QA đã duyệt trước --write) → tự transition Test Execution
# sang status này để "đóng" vòng chạy. Bỏ trống = KHÔNG transition (giữ Open — mặc định an toàn).
# Đặt "Done" để tự đóng. KHÔNG tự Done lúc tạo/chưa conclusive. --no-done bỏ qua 1 lần. (Test Plan Done cuối sprint, tách biệt.)
XRAY_EXECUTION_DONE_STATUS=
JIRA_TESTCASE_PARENT_MODE=auto
JIRA_TESTCASE_DRY_RUN=1
JIRA_TESTCASE_QA_APPROVED=0
JIRA_TESTCASE_DEDUP=1
JIRA_TESTCASE_LABELS=qa-testcase
# Required custom fields khi tạo issue (JSON fieldId -> value). Vài project bắt buộc, vd:
# {"customfield_10039":{"id":"10025"},"customfield_10037":[{"id":"10023"}]}
JIRA_TESTCASE_EXTRA_FIELDS=
XRAY_TEST_TYPE=Manual
XRAY_TEST_TYPE_FIELD_ID=
XRAY_TEST_TYPE_FIELD_MODE=option
# Link mỗi Test -> requirement (Story/Task) để Xray tính "Test Coverage". Xem USER_GUIDE §5.5.0.
XRAY_REQUIREMENT_LINK_ENABLED=1
# Tên link type tùy instance: nhiều nơi là "Test" (outward "tests"), không phải "Tests".
XRAY_REQUIREMENT_LINK_TYPE=Test
# test_to_story = kit tạo payload {inwardIssue: Test, outwardIssue: requirement}: Test ở slot inwardIssue
# (nhãn UI "is tested by"), requirement ở outwardIssue (nhãn UI "tests"). ĐÂY là chiều ĐÚNG để coverage xanh
# (đã kiểm chứng live); đảo 2 slot -> coverage trống. Nhãn đọc ngược trực giác -> bám theo payload/slot.
# LƯU Ý: coverage còn cần requirement issue type nằm trong Xray "Coverable Issue Types" (admin cấu hình).
XRAY_REQUIREMENT_LINK_DIRECTION=test_to_story
XRAY_TEST_SET_ENABLED=0
XRAY_TEST_SET_ISSUE_TYPE=Test Set
XRAY_TEST_SET_SUMMARY_PREFIX=[Test Set]
XRAY_TEST_SET_LINK_ENABLED=1
XRAY_TEST_SET_LINK_TYPE=Tests
XRAY_TEST_SET_LINK_DIRECTION=testset_to_test
XRAY_TEST_SET_STORY_LINK_ENABLED=1
XRAY_TEST_SET_LABELS=
# Xray Cloud API key (Xray > Global Settings > API Keys). BẮT BUỘC để đẩy steps/preconditions native.
# Jira API token KHÔNG ghi được steps/preconditions/test type của Xray.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_CLOUD_BASE_URL=https://xray.cloud.getxray.app
# Đẩy steps vào tab "Test details" (Test Type=Manual) và Preconditions dùng chung theo mã [PRE-xx].
XRAY_PUSH_STEPS=0
XRAY_PUSH_PRECONDITIONS=0
XRAY_PRECONDITION_ISSUE_TYPE=Precondition
# Sắp Test vào folder Test Repository (tạo nếu chưa có). Trên Git Bash truyền KHÔNG có "/" đầu.
XRAY_TEST_REPO_FOLDER=
# =1: tạo subfolder con theo tên sheet chức năng trong Excel, mỗi TC vào subfolder tương ứng.
XRAY_TEST_REPO_SUBFOLDER_BY_SHEET=0
# Sheet bỏ qua khi map subfolder theo sheet (mặc định các sheet tổng hợp/metadata).
XRAY_TESTCASE_SHEET_EXCLUDE=Summary,Test Cases,Preconditions,Setup Contracts
# Folder Test Repository cho Precondition (vd "Quản lý Exams/Preconditions").
XRAY_PRECONDITION_FOLDER=
XRAY_CLEANUP_QA_APPROVED=0
XRAY_CLEANUP_APPLY=0
XRAY_CLEANUP_DEPRECATE_LABELS=deprecated,out-of-scope,stale-from-excel
XRAY_CLEANUP_UNLINK_STALE=0
XRAY_CLEANUP_RESTORE_ACTIVE=1

# Confluence
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAGE_ID=
CONFLUENCE_REQUIREMENT_URL=

# Figma
FIGMA_FILE_URL=
FIGMA_FILE_KEY=
FIGMA_NODE_ID=
FIGMA_API_KEY=

# HubSpot test account only
HUBSPOT_ENV=test
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_UI_DOMAIN=app.hubspot.com
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_MCP_PACKAGE=@hubspot/mcp-server@0.4.0

# Google Sheet
GOOGLE_SPREADSHEET_ID=
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Playwright artifacts
PW_TRACE=off
PW_VIDEO=off

# ==========================================================================
# Kho DB UAT — READ-ONLY verify/chẩn đoán (PostgreSQL). CHỈ dùng qua guarded
# client tests/support/setup/db/uatPgClient.ts. KHÔNG import 'pg' ở chỗ khác.
#
# Điền credential của kho UAT. Kho UAT và PROD tách biệt: chỉ cấu hình kho UAT
# ở đây thì client chỉ kết nối đúng kho đó; không điền creds => không truy cập.
# Read-only: chỉ chạy SELECT trong transaction READ ONLY (bảo vệ kho UAT khỏi
# ghi nhầm). Nên dùng DB user chỉ có quyền CONNECT + SELECT (least-privilege).
# Vai trò: oracle PHỤ (field trống do FE hay BE? dữ liệu có persist không?).
#    KHÔNG dùng dựng state, KHÔNG phải evidence Jira, KHÔNG thay oracle từ spec.
#    PII đọc ra phải mask trong report, không export file (org rule bảo mật).
# ==========================================================================
LIB_MASTER_DB_HOST=
LIB_MASTER_DB_PORT=5432
LIB_MASTER_DB_NAME=
LIB_MASTER_DB_USERNAME=
LIB_MASTER_DB_PASSWORD=
# Tùy chọn: giới hạn host được kết nối (danh sách phẩy). Bỏ trống => không giới hạn.
LIB_MASTER_DB_ALLOWED_HOSTS=
# Tùy chọn: chặn host/dbname khớp mẫu (danh sách phẩy). Bỏ trống => không áp.
LIB_MASTER_DB_DENY_HOST_PATTERNS=
# true nếu kho UAT yêu cầu SSL.
LIB_MASTER_DB_SSL=false
# Timeout mỗi query (ms) để không nện DB UAT chung.
LIB_MASTER_DB_STATEMENT_TIMEOUT_MS=5000
